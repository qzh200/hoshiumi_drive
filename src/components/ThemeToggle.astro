---
/**
 * ThemeToggle —— 右上角三态切换（light / dark / system）
 * 由 config.theme.allowSwitch 控制是否渲染。
 */
import type { SiteConfig } from '../config/schema.ts';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
if (!config.theme.allowSwitch) return Astro.redirect ? null : null;
---

<button
  type="button"
  class="theme-toggle"
  aria-label="切换主题"
  data-theme-toggle
>
  <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--system" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="14" rx="2" />
      <path d="M8 20h8M12 18v2" />
    </svg>
  </span>
</button>

<script>
  // 三态轮转：light → dark → system → light …
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const order = ['light', 'dark', 'system'] as const;
  const apply = (choice: (typeof order)[number]) => {
    const win = window as unknown as { driveTheme?: { set: (c: string) => void } };
    win.driveTheme?.set(choice);
  };
  button?.addEventListener('click', () => {
    const current = ((window as unknown as { driveTheme?: { get: () => string } }).driveTheme?.get() ?? 'system') as (typeof order)[number];
    const idx = order.indexOf(current);
    apply(order[(idx + 1) % order.length]);
  });
</script>
