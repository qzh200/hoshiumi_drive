---
import type { SiteConfig } from '../config/schema.ts';
import { getSiteConfig } from '../config/loader.ts';

const config = getSiteConfig() as SiteConfig;
const { header, site } = config;
const animated = config.animation.enabled && config.animation.entrance;
---

<main class="page-main">
  <header class="drive-header entrance" style={animated ? '--delay: 0ms' : ''}>
    <div>
      <p class="drive-header__eyebrow">{header.eyebrow}</p>
      <h1 class="drive-header__title">{header.title}</h1>
      <p class="drive-header__subtitle">{header.subtitle}</p>
      {site.description && <p class="drive-header__desc">{site.description}</p>}
    </div>
  </header>

  <nav class="drive-toolbar entrance" style={animated ? '--delay: 80ms' : ''} aria-label="路径">
    <button class="drive-btn drive-btn--ghost" data-up title="返回上级" type="button" disabled>↑ 返回上级</button>
    <span class="drive-crumb">
      <span class="drive-crumb__prefix">/</span>
      <span class="drive-crumb__path" data-crumb>根目录</span>
    </span>
  </nav>

  <p class="drive-notice" data-notice role="status"></p>

  <section class="drive-list entrance" style={animated ? '--delay: 160ms' : ''} aria-live="polite" data-list>
    <p class="drive-loading">正在载入文件…</p>
  </section>
</main>

<!-- toast 浮窗（操作进度 / 成功 / 失败） -->
<div class="drive-toasts" data-toasts role="status" aria-live="polite"></div>

<!-- 文件预览 dialog -->
<dialog class="drive-preview" data-preview aria-label="文件预览">
  <header class="drive-preview__bar">
    <div class="drive-preview__title" data-preview-name>预览</div>
    <div class="drive-preview__actions">
      <button class="drive-btn drive-btn--ghost drive-preview__nav" data-preview-prev type="button" title="上一张" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="drive-btn drive-btn--ghost drive-preview__nav" data-preview-next type="button" title="下一张" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <a class="drive-btn drive-btn--ghost" data-preview-download href="#" download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon">
          <path d="M12 4v12M6 12l6 6 6-6M4 20h16" />
        </svg>
        <span>下载</span>
      </a>
      <button class="drive-btn drive-btn--primary" data-preview-close type="button">关闭</button>
    </div>
  </header>
  <div class="drive-preview__body" data-preview-body>
    <p class="drive-preview__placeholder">载入中…</p>
  </div>
  <p class="drive-preview__note" data-preview-note role="status"></p>
</dialog>

<template data-row-template>
  <article class="drive-row" data-row>
    <button class="drive-row__main" type="button" data-row-main>
      <span class="drive-row__icon" data-icon></span>
      <div class="drive-row__body">
        <span class="drive-row__name" data-name></span>
        <span class="drive-row__meta" data-meta></span>
      </div>
    </button>
    <div class="drive-row__actions" data-actions></div>
  </article>
</template>
