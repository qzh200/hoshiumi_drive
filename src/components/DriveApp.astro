---
import type { SiteConfig } from '../config/schema.ts';
import { getSiteConfig } from '../config/loader.ts';

const config = getSiteConfig() as SiteConfig;
const { header, site } = config;
const animated = config.animation.enabled && config.animation.entrance;
---

<main class="page-main">
  <header class="drive-header entrance" style={animated ? '--delay: 0ms' : ''}>
    <div>
      <p class="drive-header__eyebrow">{header.eyebrow}</p>
      <h1 class="drive-header__title">{header.title}</h1>
      <p class="drive-header__subtitle">{header.subtitle}</p>
      {site.description && <p class="drive-header__desc">{site.description}</p>}
    </div>
  </header>

  <nav class="drive-toolbar entrance" style={animated ? '--delay: 80ms' : ''} aria-label="路径">
    <button class="drive-btn drive-btn--ghost" data-up title="返回上级" type="button" disabled>↑ 返回上级</button>
    <nav class="drive-crumb" data-crumb aria-label="当前位置"></nav>
    <div class="drive-toolbar__spacer"></div>
    <button class="drive-btn drive-btn--ghost" data-select-toggle type="button" title="多选模式" aria-pressed="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon">
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M9 12l2 2 4-4" />
      </svg>
      <span>多选</span>
    </button>
    <button class="drive-btn drive-btn--ghost" data-search-btn type="button" title="搜索文件">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" />
      </svg>
      <span>搜索</span>
    </button>
  </nav>

  <p class="drive-notice" data-notice role="status"></p>

  <section class="drive-list entrance" style={animated ? '--delay: 160ms' : ''} aria-live="polite" data-list>
    <p class="drive-loading">正在载入文件…</p>
  </section>
</main>

<!-- toast 浮窗（操作进度 / 成功 / 失败） -->
<div class="drive-toasts" data-toasts role="status" aria-live="polite"></div>

<!-- 多选操作栏：选中项 ≥ 1 时显示 -->
<div class="drive-actionbar" data-actionbar role="region" aria-label="选中操作" hidden>
  <span class="drive-actionbar__count" data-actionbar-count>已选 0 项</span>
  <button class="drive-btn drive-btn--ghost" type="button" data-actionbar-all>全选当前目录</button>
  <div class="drive-actionbar__spacer"></div>
  <button class="drive-btn drive-btn--primary" type="button" data-actionbar-pack>打包选中</button>
  <button class="drive-btn drive-btn--ghost" type="button" data-actionbar-clear>清除</button>
</div>

<!-- 文件预览 dialog（顶层文件 / ZIP 内容浏览器共用） -->
<dialog class="drive-preview" data-preview aria-label="文件预览">
  <header class="drive-preview__bar">
    <div class="drive-preview__title" data-preview-name>预览</div>
    <div class="drive-preview__actions">
      <button class="drive-btn drive-btn--ghost drive-preview__nav" data-preview-prev type="button" title="上一张" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="drive-btn drive-btn--ghost drive-preview__nav" data-preview-next type="button" title="下一张" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <a class="drive-btn drive-btn--ghost" data-preview-download href="#" download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon">
          <path d="M12 4v12M6 12l6 6 6-6M4 20h16" />
        </svg>
        <span>下载</span>
      </a>
      <button class="drive-btn drive-btn--primary drive-preview__close" data-preview-close type="button" aria-label="关闭预览" title="关闭预览">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="drive-btn__icon" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        <span>关闭</span>
      </button>
    </div>
  </header>
  <div class="drive-preview__body" data-preview-body>
    <p class="drive-preview__placeholder">载入中…</p>
  </div>
  <p class="drive-preview__note" data-preview-note role="status"></p>
</dialog>

<!-- ZIP 内文件预览 dialog（独立层，关闭不影响外层 ZIP 浏览器） -->
<dialog class="drive-preview drive-preview--inner" data-preview-inner aria-label="ZIP 内文件预览">
  <header class="drive-preview__bar">
    <div class="drive-preview__title" data-preview-inner-name>预览</div>
    <div class="drive-preview__actions">
      <button class="drive-btn drive-btn--ghost drive-preview__nav" data-preview-inner-prev type="button" title="上一张" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="drive-btn drive-btn--ghost drive-preview__nav" data-preview-inner-next type="button" title="下一张" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <a class="drive-btn drive-btn--ghost" data-preview-inner-download href="#" download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-btn__icon">
          <path d="M12 4v12M6 12l6 6 6-6M4 20h16" />
        </svg>
        <span>下载</span>
      </a>
      <button class="drive-btn drive-btn--primary drive-preview__close" data-preview-inner-close type="button" aria-label="关闭预览" title="关闭预览">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="drive-btn__icon" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        <span>关闭</span>
      </button>
    </div>
  </header>
  <div class="drive-preview__body" data-preview-inner-body>
    <p class="drive-preview__placeholder">载入中…</p>
  </div>
  <p class="drive-preview__note" data-preview-inner-note role="status"></p>
</dialog>

<!-- 搜索 dialog -->
<dialog class="drive-search" data-search-modal aria-label="搜索文件">
  <header class="drive-search__bar">
    <div class="drive-search__input-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="drive-search__icon">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" />
      </svg>
      <input class="drive-search__input" data-search-input type="search" placeholder="输入文件名（搜索当前目录及子目录）" autocomplete="off" spellcheck="false" />
    </div>
    <button class="drive-btn drive-btn--primary drive-search__close" data-search-close type="button" aria-label="关闭搜索" title="关闭搜索">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="drive-btn__icon" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      <span>关闭</span>
    </button>
  </header>
  <p class="drive-search__status" data-search-status role="status"></p>
  <ul class="drive-search__results" data-search-results></ul>
</dialog>

<template data-row-template>
  <article class="drive-row" data-row>
    <label class="drive-row__check" data-check-wrap>
      <input type="checkbox" class="drive-row__checkbox" data-select />
    </label>
    <button class="drive-row__main" type="button" data-row-main>
      <span class="drive-row__icon" data-icon></span>
      <div class="drive-row__body">
        <span class="drive-row__name" data-name></span>
        <span class="drive-row__meta" data-meta></span>
      </div>
    </button>
    <div class="drive-row__actions" data-actions></div>
  </article>
</template>
