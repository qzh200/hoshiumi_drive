---
/**
 * BackLink —— 左上角「返回 Hoshiumi 主页」按钮
 *
 * 视觉上与右上角 .theme-toggle 镜像：同样 40px 圆形 + 玻璃 + 蓝色 hover，
 * 保持顶部两角的视觉平衡，让子站看起来与 home 是同一个生态。
 *
 * 跳回 https://hoshiumi.xyz/（即 hoshiumi_home 入口页）。
 */
const HOME_URL = 'https://hoshiumi.xyz/';
---

<a
  class="back-link"
  href={HOME_URL}
  aria-label="返回 Hoshiumi 主页"
  title="返回 Hoshiumi 主页"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 12H5" />
    <path d="M12 19l-7-7 7-7" />
  </svg>
</a>
