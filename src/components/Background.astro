---
/**
 * Background —— 极光 + 渐变 + 星星 + 噪点
 * 完全复用主页（hoshiumi_home）的视觉语言；星星位置由固定种子生成，构建可复现。
 */
import type { SiteConfig } from '../config/schema.ts';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const bg = config.background;
const drift = config.animation.enabled && config.animation.backgroundDrift;
const twinkle = bg.stars.enabled;

interface StarStyle {
  left: string;
  top: string;
  animationDelay: string;
  animationDuration: string;
  kind: 'sm' | 'lg';
}

/* ------------------------------------------------------------------ */
/* 星星：使用固定种子生成可复现的伪随机位置（与 home 一致）            */
/* ------------------------------------------------------------------ */
function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function hashString(value: string): number {
  let hash = 2166136261;
  for (let i = 0; i < value.length; i++) {
    hash ^= value.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

const seedBase = `${config.site.url}#drive-stars`;
const rand = mulberry32(hashString(seedBase));

const stars: StarStyle[] = [];
if (twinkle) {
  const count = bg.stars.count;
  for (let i = 0; i < count; i++) {
    stars.push({
      left: `${Math.round(rand() * 98)}%`,
      top: `${Math.round(rand() * 96)}%`,
      // 闪烁节奏错开，避免整体"呼吸感"
      animationDelay: `${(rand() * 6).toFixed(2)}s`,
      animationDuration: `${(4.5 + rand() * 4.5).toFixed(2)}s`,
      kind: rand() > 0.82 ? 'lg' : 'sm',
    });
  }
}

const aurora = bg.type === 'aurora';
const classes = [
  'bg-scene',
  bg.gradient ? 'bg-scene--gradient' : '',
  drift ? 'bg-scene--moving' : '',
  twinkle ? 'bg-scene--twinkle' : '',
].filter(Boolean).join(' ');
---

<div class={classes} aria-hidden="true">
  {bg.gradient && aurora && <div class="bg-scene__layer bg-scene__tint" />}

  {aurora && bg.glow && (
    <div class="bg-scene__layer">
      <div class="orb orb--a" />
      <div class="orb orb--b" />
      <div class="orb orb--c" />
    </div>
  )}

  {twinkle && (
    <div class="bg-scene__layer">
      {stars.map((star) => (
        <i
          class:list={['star', star.kind === 'lg' ? 'star--lg' : 'star--sm']}
          style={`left:${star.left};top:${star.top};animation-delay:${star.animationDelay};animation-duration:${star.animationDuration}`}
        />
      ))}
    </div>
  )}

  {bg.noise && <div class="bg-scene__layer bg-scene__noise" />}
</div>
