---
/**
 * Layout —— 页面骨架
 *
 * 职责：
 *   1. 根据 config/site.yaml 输出全部 SEO / OG / theme-color / JSON-LD；
 *   2. 把配置中的颜色与卡片参数编译成 CSS 变量注入 <head>；
 *   3. 内置主题引导脚本：首帧渲染前从 localStorage / 系统偏好恢复主题，
 *      避免暗色用户看到白屏闪烁。
 */
import '../styles/global.css';
import type { SiteConfig } from '../config/schema.ts';
import { getSiteConfig } from '../config/loader.ts';
import { buildThemeStyle, ogImageUrl } from '../config/helpers.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const config = getSiteConfig() as SiteConfig;
const { site, theme, seo, animation } = config;

const pageTitle = (title ?? '').trim() || seo.title;
const pageDescription = (description ?? '').trim() || seo.description;
const keywords = site.keywords.join(', ');

const ogImage = seo.openGraph.enabled ? ogImageUrl(config) : '';
const themeStyle = buildThemeStyle(config);

function faviconMime(path: string): string {
  const ext = path.split('?')[0]!.split('.').pop()!.toLowerCase();
  const map: Record<string, string> = {
    svg: 'image/svg+xml',
    png: 'image/png',
    webp: 'image/webp',
    ico: 'image/x-icon',
    jpg: 'image/jpeg',
    jpeg: 'image/jpeg',
    avif: 'image/avif',
  };
  return map[ext] ?? 'image/png';
}

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  alternateName: site.alternate,
  url: site.url,
  description: site.description,
});
---

<!doctype html>
<html
  lang={site.language}
  data-theme-default={theme.default}
  data-allow-switch={theme.allowSwitch}
  data-respect-motion={animation.respectReducedMotion}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {keywords && <meta name="keywords" content={keywords} />}

    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type={faviconMime(site.favicon)} href={site.favicon} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content={theme.light.background} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={theme.dark.background} />

    {
      seo.openGraph.enabled && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={site.title} />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={pageDescription} />
          <meta property="og:url" content={seo.canonical} />
          {ogImage && <meta property="og:image" content={ogImage} />}
        </>
      )
    }

    {
      seo.twitter.enabled && (
        <>
          <meta name="twitter:card" content={seo.twitter.card} />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={pageDescription} />
          {ogImage && <meta name="twitter:image" content={ogImage} />}
        </>
      )
    }

    <script is:inline type="application/ld+json" set:html={structuredData} />

    <script is:inline>
      (function () {
        try {
          var KEY = 'drive-theme';
          var root = document.documentElement;
          var allowSwitch = root.getAttribute('data-allow-switch') !== 'false';
          var def = root.getAttribute('data-theme-default') || 'system';
          var stored = null;
          try { stored = localStorage.getItem(KEY); } catch (e) { /* noop */ }
          var choice = stored && allowSwitch ? stored : def;
          if (choice !== 'light' && choice !== 'dark' && choice !== 'system') choice = 'system';
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          function effective(c) { return c === 'system' ? (mq.matches ? 'dark' : 'light') : c; }
          function apply() {
            root.setAttribute('data-theme', effective(choice));
            root.setAttribute('data-theme-choice', choice);
          }
          apply();
          if (typeof mq.addEventListener === 'function') {
            mq.addEventListener('change', function () { if (choice === 'system') apply(); });
          }
          window.driveTheme = {
            get: function () { return choice; },
            set: function (next) {
              if (!allowSwitch) return;
              choice = next === 'light' || next === 'dark' || next === 'system' ? next : 'system';
              try { localStorage.setItem(KEY, choice); } catch (e) { /* noop */ }
              apply();
            },
          };
        } catch (e) { /* noop */ }
      })();
    </script>

    <style is:inline set:html={themeStyle} />
  </head>
  <body>
    <slot />
  </body>
</html>
