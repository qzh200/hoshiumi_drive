{
  "name": "hoshiumi-drive",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "config:build": "node ./scripts/build-storage-config.mjs",
    "predev": "pnpm config:build",
    "prebuild": "pnpm config:build",
    "dev": "astro dev",
    "build": "astro build && node ./scripts/postbuild.mjs",
    "preview": "astro preview",
    "postbuild": "node ./scripts/postbuild.mjs",
    "check": "astro check",
    "cf:dev": "wrangler pages dev dist --d1=DB",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 execute DB --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "astro": "^7.2.10",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
